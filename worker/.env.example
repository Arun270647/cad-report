# Copy to worker/.env and fill in WORKER_TOKEN. Real environment variables override this file.
WORKER_URL=https://panel-bom-pricer.vercel.app
# Same value as WORKER_TOKEN in the Vercel project (>= 32 random chars). Keep it secret.
WORKER_TOKEN=
# Optional: path to Claude Code if it is not found automatically. May include leading args, e.g.
#   CLAUDE_BIN=C:\Users\me\.local\bin\claude.exe
#   CLAUDE_BIN="C:\Program Files\nodejs\node.exe" "C:\Users\me\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\cli.js"
CLAUDE_BIN=
# Optional: model alias/ID passed as --model (empty = Claude Code's default for your plan).
CLAUDE_MODEL=
POLL_INTERVAL_MS=5000
TASK_TIMEOUT_MS=480000
# Sheets of the active drawing read in parallel (1..4). Drawings still queue one after another.
CONCURRENCY=4
# Optional: where per-task scratch folders are created (default: <worker folder>\tmp).
WORK_DIR=
