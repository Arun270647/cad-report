# Copy to .env.local for local development. NEVER commit real values.
DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/postgres
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
# 32 random bytes, base64 encoded (openssl rand -base64 32)
ENCRYPTION_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login
# Optional: Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
