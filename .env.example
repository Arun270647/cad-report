# Copy to .env.local for local development. NEVER commit real values.
# Extraction runs ONLY on the PC worker (Claude Code with a claude.ai login) — the web app holds no AI API key.
DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/postgres
# Comma-separated emails allowed to sign in, and the subset allowed to open /admin (worker status, pause/resume).
ALLOWED_EMAILS=you@example.com
ADMIN_EMAILS=you@example.com
# >= 32 random chars each (e.g. openssl rand -hex 32)
SESSION_SECRET=
WORKER_TOKEN=
# >= 16 random chars; the GitHub Actions worker check sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
